{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activitypods.org/contracts/ap.delivery-plan.v1.schema.json",
  "title": "ActivityPub Delivery Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intentId", "activityId", "actorUri", "activity", "localRecipients", "remoteRecipients", "meta"],
  "properties": {
    "schema": { "const": "ap.delivery-plan.v1" },
    "intentId": { "type": "string", "minLength": 1 },
    "activityId": { "type": "string", "format": "uri" },
    "actorUri": { "type": "string", "format": "uri" },
    "activity": { "type": "object" },
    "localRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorUri", "dataset", "inboxUri"],
        "properties": {
          "actorUri": { "type": "string", "format": "uri" },
          "dataset": { "type": "string", "minLength": 1 },
          "inboxUri": { "type": "string", "format": "uri" }
        }
      }
    },
    "remoteRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorUri", "inboxUrl", "targetDomain"],
        "properties": {
          "actorUri": { "type": "string", "format": "uri" },
          "inboxUrl": { "type": "string", "format": "uri" },
          "sharedInboxUrl": { "type": "string", "format": "uri" },
          "targetDomain": { "type": "string", "minLength": 1 }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "isPublicActivity"],
      "properties": {
        "visibility": { "enum": ["public", "unlisted", "followers", "direct"] },
        "isPublicActivity": { "type": "boolean" },
        "isPublicIndexable": { "type": "boolean" },
        "searchConsent": { "type": ["object", "null"] }
      }
    }
  }
}
