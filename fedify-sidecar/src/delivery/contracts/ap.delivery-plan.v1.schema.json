{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activitypods.org/contracts/ap.delivery-plan.v1.schema.json",
  "title": "ActivityPub Delivery Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intentId", "activityId", "actorUri", "activity", "localRecipients", "remoteRecipients", "meta"],
  "properties": {
    "schema": { "const": "ap.delivery-plan.v1" },
    "intentId": { "type": "string", "pattern": "^apdm-v1-[a-f0-9]{64}$" },
    "activityId": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
      "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" }
    },
    "actorUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
      "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" }
    },
    "activity": { "type": "object" },
    "localRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorUri", "dataset", "inboxUri"],
        "properties": {
          "actorUri": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
            "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" }
          },
          "dataset": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
          },
          "inboxUri": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
            "allOf": [
              { "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" } },
              { "not": { "pattern": "#" } }
            ]
          }
        }
      }
    },
    "remoteRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorUri", "inboxUrl", "targetDomain"],
        "properties": {
          "actorUri": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
            "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" }
          },
          "inboxUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
            "allOf": [
              { "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" } },
              { "not": { "pattern": "#" } }
            ]
          },
          "sharedInboxUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s\\u0000-\\u001F\\u007F]+$",
            "allOf": [
              { "not": { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#]*@" } },
              { "not": { "pattern": "#" } }
            ]
          },
          "targetDomain": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$",
            "not": {
              "anyOf": [
                { "pattern": "[A-Z]" },
                { "pattern": "\\.$" }
              ]
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "isPublicActivity"],
      "properties": {
        "visibility": { "enum": ["public", "unlisted", "followers", "direct"] },
        "isPublicActivity": { "type": "boolean" },
        "isPublicIndexable": { "type": "boolean" },
        "searchConsent": { "type": ["object", "null"] }
      }
    }
  }
}
