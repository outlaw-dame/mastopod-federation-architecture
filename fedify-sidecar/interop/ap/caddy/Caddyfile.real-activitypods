# The workflow selects exactly one return-path authority for each mode. Never
# fail a signed POST over between upstreams: a retry can lose or alter its body,
# and fallback would make the authority-path evidence ambiguous.
(activitypods_return_path) {
  @actorInbox {
    method POST
    path_regexp actor_inbox ^/(users/)?[^/]+/inbox/?$
  }
  handle @actorInbox {
    reverse_proxy {$ACTIVITYPODS_RETURN_HOST:host.docker.internal}:{$ACTIVITYPODS_RETURN_PORT:3000}
  }
  handle {
    reverse_proxy host.docker.internal:3000
  }
}

# Canonical public ActivityPods actor/key surface for the live federation proof.
# Actor/key/discovery GETs always remain authoritative on ActivityPods itself;
# only remote POSTs to a concrete actor inbox participate in the return-path
# routing above.
https://activitypods {
  tls /certs/activitypods.crt /certs/activitypods.key
  import activitypods_return_path
}

https://activitypods.test {
  tls /certs/activitypods.test.crt /certs/activitypods.test.key
  import activitypods_return_path
}
