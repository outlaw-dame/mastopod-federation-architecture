{
  admin off
  auto_https off
}

https://sidecar {
  tls /certs/sidecar.crt /certs/sidecar.key
  reverse_proxy fedify-sidecar:8080
}

https://gotosocial {
  tls /certs/gotosocial.crt /certs/gotosocial.key
  reverse_proxy gotosocial-app:8080
}

https://mastodon {
  tls /certs/mastodon.crt /certs/mastodon.key
  # Transparent test-only recorder retains bounded signer/body-correlation
  # metadata and forwards the request unchanged to the real Mastodon process.
  # Preserve the public authority explicitly because Host is part of the
  # Cavage signature base string verified by Mastodon.
  reverse_proxy mastodon-wire-recorder:8788 {
    header_up Host {http.request.host}
  }
}

https://akkoma {
  tls /certs/akkoma.crt /certs/akkoma.key
  reverse_proxy akkoma-app:4000
}

https://pixelfed.test {
  tls /certs/pixelfed.test.crt /certs/pixelfed.test.key
  reverse_proxy pixelfed-app:8080
}

https://bonfire.test {
  tls /certs/bonfire.test.crt /certs/bonfire.test.key
  reverse_proxy bonfire-app:4000
}

https://misskey.test {
  tls /certs/misskey.test.crt /certs/misskey.test.key
  reverse_proxy misskey-app:3000
}

https://friendica.test {
  tls /certs/friendica.test.crt /certs/friendica.test.key
  reverse_proxy friendica-app:80
}

https://castopod.test {
  tls /certs/castopod.test.crt /certs/castopod.test.key
  reverse_proxy castopod-app:8000
}

# In native mode port 8080 is deliberately absent, so Caddy marks that first
# upstream unavailable and retries the exact ActivityPods backend. In external
# mode the sidecar is already healthy on 8080; every actor-inbox POST therefore
# enters the production sidecar ingress first. The external proof separately
# requires the exact returning Accept in ap:queue:inbound:v1, so an unexpected
# fallback to the backend cannot produce a false green result.
(activitypods_return_path) {
  @actorInbox {
    method POST
    path_regexp actor_inbox ^/(users/)?[^/]+/inbox/?$
  }
  handle @actorInbox {
    reverse_proxy host.docker.internal:8080 host.docker.internal:3000 {
      lb_policy first
      fail_duration 30s
      lb_try_duration 3s
      lb_try_interval 100ms
    }
  }
  handle {
    reverse_proxy host.docker.internal:3000
  }
}

# Canonical public ActivityPods actor/key surface for the live federation proof.
# Actor/key/discovery GETs always remain authoritative on ActivityPods itself;
# only remote POSTs to a concrete actor inbox participate in the return-path
# routing above.
https://activitypods {
  tls /certs/activitypods.crt /certs/activitypods.key
  import activitypods_return_path
}

https://activitypods.test {
  tls /certs/activitypods.test.crt /certs/activitypods.test.key
  import activitypods_return_path
}
