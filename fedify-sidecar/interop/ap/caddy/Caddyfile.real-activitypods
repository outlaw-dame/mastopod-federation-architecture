{
  admin off
  auto_https off
}

https://sidecar {
  tls /certs/sidecar.crt /certs/sidecar.key
  reverse_proxy fedify-sidecar:8080
}

https://gotosocial {
  tls /certs/gotosocial.crt /certs/gotosocial.key
  reverse_proxy gotosocial-wire-recorder:8788 {
    header_up Host {http.request.host}
  }
}

https://mastodon {
  tls /certs/mastodon.crt /certs/mastodon.key
  # Transparent test-only recorder retains bounded signer/body-correlation
  # metadata and forwards the request unchanged to the real Mastodon process.
  # Preserve the public authority explicitly because Host is part of the
  # Cavage signature base string verified by Mastodon.
  reverse_proxy mastodon-wire-recorder:8788 {
    header_up Host {http.request.host}
  }
}

