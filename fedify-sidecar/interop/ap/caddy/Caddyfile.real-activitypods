{
  admin off
  auto_https off
}

https://sidecar {
  tls /certs/sidecar.crt /certs/sidecar.key
  reverse_proxy fedify-sidecar:8080
}

https://gotosocial {
  tls /certs/gotosocial.crt /certs/gotosocial.key
  reverse_proxy gotosocial-app:8080
}

https://mastodon {
  tls /certs/mastodon.crt /certs/mastodon.key
  reverse_proxy mastodon-web-app:3000
}

https://akkoma {
  tls /certs/akkoma.crt /certs/akkoma.key
  reverse_proxy akkoma-app:4000
}

https://pixelfed.test {
  tls /certs/pixelfed.test.crt /certs/pixelfed.test.key
  reverse_proxy pixelfed-app:8080
}

https://bonfire.test {
  tls /certs/bonfire.test.crt /certs/bonfire.test.key
  reverse_proxy bonfire-app:4000
}

https://misskey.test {
  tls /certs/misskey.test.crt /certs/misskey.test.key
  reverse_proxy misskey-app:3000
}

https://friendica.test {
  tls /certs/friendica.test.crt /certs/friendica.test.key
  reverse_proxy friendica-app:80
}

# Canonical public ActivityPods actor/key surface for the live federation proof.
# The backend remains a host process so the exact PR checkout is exercised;
# Caddy supplies the local trusted TLS name that remote implementations can
# dereference from inside the interop Docker network.
https://activitypods {
  tls /certs/activitypods.crt /certs/activitypods.key
  reverse_proxy host.docker.internal:3000
}

https://activitypods.test {
  tls /certs/activitypods.test.crt /certs/activitypods.test.key
  reverse_proxy host.docker.internal:3000
}
